<navigation-bar
  title="灵序穿搭"
  back="{{true}}"
  color="#4c3b25"
  background="rgba(255, 253, 247, .94)"
></navigation-bar>

<view class="login-page">
  <image
    class="login-background"
    src="/images/common/bg.png"
    mode="aspectFill"
  ></image>
  <view class="login-mask"></view>

  <view class="brand-copy">
    <image class="login-title-image" src="/images/common/title.png" mode="widthFix" />
    <text class="brand-subtitle">穿出你的好运势</text>
  </view>

  <view class="login-action-panel">
    <view class="panel-heading">
      <text class="panel-title">登录后查看完整穿搭</text>
      <text class="panel-desc">保存你的收藏、积分与每日穿搭记录</text>
    </view>

    <view class="profile-fill">
      <text class="profile-fill-title">个性化资料（选填）</text>
      <view class="profile-fill-row">
        <view class="avatar-wrap">
          <button
            class="avatar-choose"
            open-type="chooseAvatar"
            bind:chooseavatar="onChooseAvatar"
            hover-class="avatar-choose-hover"
          >
            <image
              class="avatar-preview"
              src="{{avatarUrl || '/images/icons/user.png'}}"
              mode="aspectFill"
            />
          </button>
          <view class="avatar-badge">＋</view>
        </view>
        <input
          class="nickname-input"
          type="nickname"
          placeholder="点击填写昵称"
          placeholder-class="nickname-placeholder"
          value="{{nickName}}"
          bindinput="onNickNameInput"
        />
      </view>
      <text class="profile-fill-hint">可一键使用微信头像与昵称，也可自行填写自定义资料</text>
    </view>

    <button
      class="wechat-login-button"
      loading="{{loading}}"
      disabled="{{!canLogin || loading}}"
      bindtap="onLogin"
    >
      微信授权一键登录
    </button>

    <text class="login-error" wx:if="{{error}}">{{error}}</text>
    <button class="skip-login-button" bindtap="onSkip">
      暂不登录，返回首页
    </button>

    <view class="agreement-text">
      <text>登录即表示同意</text>
      <text class="agreement-link" data-type="user_agreement" catchtap="onOpenLegal">《用户协议》</text>
      <text>和</text>
      <text class="agreement-link" data-type="privacy" catchtap="onOpenLegal">《隐私政策》</text>
    </view>
  </view>
</view>
