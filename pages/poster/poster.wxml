<navigation-bar
  wx:if="{{!singlePageMode}}"
  title="今日穿搭日签"
  back="{{true}}"
  color="#3d3529"
  background="#fffdf7"
></navigation-bar>

<view class="poster-page">
  <view class="state-container" wx:if="{{loading}}">
    <view class="lx-spinner" style="border-top-color:#b08a4d"></view>
    <text>正在生成今日日签...</text>
  </view>

  <view class="state-container" wx:elif="{{error}}">
    <image class="state-icon" src="/images/icons/warning.png" mode="aspectFit" />
    <text>{{error}}</text>
    <view class="retry-button" hover-class="retry-button--hover" bindtap="onRetry">重新加载</view>
  </view>

  <block wx:else>
    <view class="poster-canvas-wrap">
      <canvas
        id="posterCanvas"
        type="2d"
        class="poster-canvas"
      ></canvas>
    </view>

    <view class="poster-actions">
      <!-- 用 view 而非原生 button：小程序 button 的 line-height 垂直居中不可靠，
           实测文字会整体偏下；view + flex 才能保证水平/垂直都居中 -->
      <view
        class="poster-btn poster-btn--primary"
        hover-class="poster-btn--hover"
        bindtap="onSavePoster"
      >
        <view class="btn-spinner" wx:if="{{saving}}"></view>
        <text>{{saving ? '保存中...' : '保存到相册'}}</text>
      </view>
      <view
        wx:if="{{!singlePageMode}}"
        class="poster-btn"
        hover-class="poster-btn--hover"
        bindtap="onGoDetail"
      >看今日搭配</view>
    </view>

    <text class="poster-tip">保存或截图后可发朋友圈 / 视频号 / 公众号配图；好友扫海报上的小程序码可直达当日穿搭</text>
  </block>
</view>
