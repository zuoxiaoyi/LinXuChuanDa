/* 今日穿搭日签页：整页锁一屏的三段式
   ① 自定义导航栏（页面内组件，占文档流）固定高
   ② 中间 canvas 区 flex:1 吃掉全部剩余空间并铺满
   ③ 底部按钮 + 文案固定贴底
   navigationStyle=custom，导航栏与内容区同属 page 文档流，
   所以必须在 page 根上做 100vh 的 flex，内容区用 flex:1（不能自己再写 100vh，否则叠加超屏） */
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #f6ecd8;
}

navigation-bar {
  flex-shrink: 0;
  width: 100%;
}

.poster-page {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 24rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #f6ecd8;
  overflow: hidden;
}

.state-container {
  flex: 1;
  min-height: 0;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  color: #8d806b;
  font-size: 25rpx;
}

.state-icon {
  width: 58rpx;
  height: 58rpx;
}

.retry-button {
  margin: 6rpx 0 0;
  padding: 0 34rpx;
  height: 62rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  border: 1rpx solid #b99c6b;
  border-radius: 32rpx;
  background: #fffaf0;
  color: #795a2c;
  font-size: 24rpx;
}

.retry-button--hover {
  opacity: .85;
}

.lx-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 5rpx solid rgba(176, 138, 77, .25);
  border-top-color: #b08a4d;
  border-radius: 50%;
  animation: lx-spin .8s linear infinite;
}

@keyframes lx-spin {
  to { transform: rotate(360deg); }
}

/* canvas 区：吃掉全部剩余空间，画布用绝对定位铺满（不留白、不受 flex 百分比高度解析影响） */
.poster-canvas-wrap {
  width: 100%;
  flex: 1;
  min-height: 0;
  position: relative;
  border-radius: 20rpx;
  overflow: hidden;
  background: #fffdf7;
  box-shadow: 0 8rpx 24rpx rgba(104, 75, 32, .10);
}

.poster-canvas {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  display: block;
}

.poster-actions {
  width: 100%;
  flex-shrink: 0;
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.poster-btn {
  flex: 1;
  min-width: 0;
  margin: 0;
  height: 84rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  line-height: 1;
  border-radius: 42rpx;
  border: 1rpx solid #b99c6b;
  background: #fffaf0;
  color: #795a2c;
  font-size: 28rpx;
  font-weight: 600;
}

.poster-btn--hover {
  opacity: .86;
}

.poster-btn--primary {
  background: #3d3529;
  border-color: #3d3529;
  color: #f6ecd8;
}

.btn-spinner {
  width: 26rpx;
  height: 26rpx;
  margin-right: 10rpx;
  border: 3rpx solid rgba(246, 236, 216, .35);
  border-top-color: #f6ecd8;
  border-radius: 50%;
  animation: lx-spin .8s linear infinite;
}

.poster-tip {
  flex-shrink: 0;
  margin-top: 18rpx;
  max-width: 640rpx;
  color: #8b806f;
  font-size: 22rpx;
  line-height: 1.6;
  text-align: center;
}
