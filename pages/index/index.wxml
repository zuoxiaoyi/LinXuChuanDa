<navigation-bar
  title="灵序穿搭"
  back="{{false}}"
  color="#3d3529"
  background="#fffdf7"
></navigation-bar>

<scroll-view class="page-scroll" scroll-y enhanced bounces="{{false}}" show-scrollbar="{{false}}" enable-back-to-top>
<view class="page-shell">
  <image class="paper-bg" src="/images/common/index_bg.png" mode="aspectFill" />
  <view class="content">
    <view class="date-heading centered-date">
      <view class="date-main">
        <text class="date-text">{{selectedDay.dateText}}</text>
        <text class="week-text">{{selectedDay.weekText}}</text>
      </view>
      <view class="calendar-meta">
        <text class="lunar-text">{{selectedDay.lunarText}}</text>
        <text class="ganzhi-text" wx:if="{{selectedDay.ganZhiText}}">{{selectedDay.ganZhiText}}</text>
      </view>
    </view>

    <view class="color-panel">
      <view class="color-row">
        <image class="color-row-bg" src="/images/common/kuang.png" mode="scaleToFill" />
        <text class="color-label best">首选颜色</text>
        <view class="color-tags">
          <view class="color-palette-item" wx:for="{{selectedDay.primaryColorItems}}" wx:key="name">
            <text class="color-palette-text">{{item.name}}</text>
            <image class="color-palette-icon" src="{{item.icon}}" mode="aspectFit" />
          </view>
        </view>
      </view>
      <view class="color-row">
        <image class="color-row-bg" src="/images/common/kuang.png" mode="scaleToFill" />
        <text class="color-label second">次选颜色</text>
        <view class="color-tags">
          <view class="color-palette-item" wx:for="{{selectedDay.secondaryColorItems}}" wx:key="name">
            <text class="color-palette-text">{{item.name}}</text>
            <image class="color-palette-icon" src="{{item.icon}}" mode="aspectFit" />
          </view>
        </view>
      </view>
      <view class="color-row">
        <image class="color-row-bg" src="/images/common/kuang.png" mode="scaleToFill" />
        <text class="color-label avoid">不建议色</text>
        <view class="color-tags">
          <view class="color-palette-item" wx:for="{{selectedDay.avoidColorItems}}" wx:key="name">
            <text class="color-palette-text">{{item.name}}</text>
            <image class="color-palette-icon" src="{{item.icon}}" mode="aspectFit" />
          </view>
        </view>
      </view>
    </view>

    <view class="action-row">
      <button class="outline-button share-button" open-type="share">
        <image class="local-icon" src="/images/icons/share.png" mode="aspectFit" />
        <text>分享好友</text>
      </button>
      <view class="outline-button" bindtap="onGoDetail">
        <image class="local-icon" src="/images/icons/detail.png" mode="aspectFit" />
        <text>穿搭详情</text>
      </view>
    </view>

    <view class="date-strip">
      <view class="date-strip-inner">
        <view
          class="date-item {{selectedDateIndex === item.index ? 'is-active' : ''}} {{item.isLocked ? 'is-locked' : ''}}"
          wx:for="{{dateList}}"
          wx:key="index"
          data-index="{{item.index}}"
          bindtap="onSelectDate"
        >
          <text class="date-label">{{item.label || item.week}}</text>
          <text class="date-day">{{item.day}}</text>
          <image wx:if="{{item.isLocked}}" class="lock-icon" src="/images/icons/lock.png" mode="aspectFit" />
        </view>
      </view>
    </view>

    <view class="weather-card">
      <view class="weather-title">
        <picker mode="region" value="{{regionValue}}" bindchange="onRegionChange">
          <view class="city-picker weather-city-picker">
            <image class="local-icon" src="/images/icons/location.png" mode="aspectFit" />
            <text>{{cityName}}</text>
            <text class="change-city">切换城市</text>
          </view>
        </picker>
        <view class="weather-update">
          <text class="weather-status">{{weather.status}}</text>
          <text>{{weather.updatedText}}</text>
        </view>
      </view>

      <view class="weather-body">
        <text class="weather-icon">☀️</text>
        <text class="weather-temp">{{weather.temperature}}</text>
        <view class="weather-meta">
          <text>{{weather.condition}}</text>
          <text>风力 {{weather.wind}}</text>
          <text>紫外线 {{weather.ultraviolet}}</text>
        </view>
      </view>

      <view class="advice-block">
        <view class="advice-title">
          <image class="local-icon" src="/images/icons/clothes.png" mode="aspectFit" />
          <text>穿衣建议</text>
        </view>
        <text class="advice-text">{{weather.dressingAdvice}}</text>
        <view class="advice-tags" wx:if="{{weather.dressingTags.length}}">
          <text wx:for="{{weather.dressingTags}}" wx:key="*this">{{item}}</text>
        </view>
      </view>

      <view class="advice-block skincare-block">
        <view class="advice-title">
          <image class="local-icon" src="/images/icons/care.png" mode="aspectFit" />
          <text>出行护理</text>
        </view>
        <text class="advice-text">{{weather.careAdvice}}</text>
      </view>
    </view>
  </view>
</view>
</scroll-view>

<bottom-nav current="home"></bottom-nav>
