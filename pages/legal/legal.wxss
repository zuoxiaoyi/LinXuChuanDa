page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #f8f3e8;
  color: #3d3529;
}

.page-scroll {
  flex: 1;
  width: 100%;
  height: 0;
  min-height: 0;
}

.legal-page {
  position: relative;
  min-height: 100%;
  overflow: hidden;
}

.paper-bg {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: .14;
  pointer-events: none;
}

.legal-card {
  position: relative;
  z-index: 1;
  margin: 28rpx 28rpx calc(42rpx + env(safe-area-inset-bottom));
  padding: 34rpx 30rpx;
  border: 1rpx solid rgba(185, 156, 107, .28);
  border-radius: 22rpx;
  background: rgba(255, 253, 247, .92);
  box-shadow: 0 8rpx 24rpx rgba(100, 75, 38, .08);
}

.legal-title {
  display: block;
  margin-bottom: 24rpx;
  color: #594221;
  font-size: 34rpx;
  font-weight: 700;
}

.legal-content {
  color: #665b4b;
  font-size: 26rpx;
  line-height: 1.85;
}
