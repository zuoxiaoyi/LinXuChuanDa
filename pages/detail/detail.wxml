<navigation-bar
  title="穿搭详情"
  back="{{true}}"
  color="#3d3529"
  background="#fffdf7"
></navigation-bar>

<scroll-view
  class="page-scroll"
  scroll-y
  enhanced
  bounces="{{false}}"
  show-scrollbar="{{false}}"
  enable-back-to-top
>
<view class="detail-page">
  <image class="detail-bg" src="/images/common/index_bg.png" mode="aspectFill" />
  <view class="detail-content">
    <view class="date-heading">
      <text>{{singleMode ? '穿搭详情' : dateText}}</text>
      <text class="date-subtitle">{{singleMode ? '已收藏的单套穿搭' : '今日场景穿搭'}}</text>
    </view>

    <view class="state-container" wx:if="{{loading}}">
      <van-loading size="46rpx" color="#b08a4d" vertical>加载穿搭方案...</van-loading>
    </view>

    <view class="state-container" wx:elif="{{error}}">
      <image class="state-icon" src="/images/icons/warning.png" mode="aspectFit" />
      <text>{{error}}</text>
      <button class="retry-button" bindtap="onRetry">重新加载</button>
    </view>

    <view class="state-container" wx:elif="{{singleMode}}">
      <view class="single-outfit">
        <image
          wx:if="{{singleOutfit.coverUrl}}"
          class="single-cover"
          src="{{singleOutfit.coverUrl}}"
          mode="widthFix"
          lazy-load
          data-url="{{singleOutfit.coverUrl}}"
          bindtap="onPreviewImage"
        />
        <view class="image-placeholder empty-outfit" wx:else>
          <image class="image-placeholder-icon" src="/images/icons/image.png" mode="aspectFit" />
          <text>暂无图片</text>
        </view>

        <text class="single-title">{{singleOutfit.title}}</text>

        <view class="single-tags" wx:if="{{singleOutfit.tags.length}}">
          <text class="single-tag" wx:for="{{singleOutfit.tags}}" wx:key="*this">{{item}}</text>
        </view>

        <view
          class="collect-bar"
          catchtap="onToggleCollectSingle"
        >
          <view class="collect-button {{singleCollected ? 'is-collected' : ''}}">
            <image
              class="collect-icon"
              src="{{singleCollected ? '/images/icons/star.png' : '/images/icons/star-outline.png'}}"
              mode="aspectFit"
            />
            <text class="collect-text">{{singleCollected ? '已收藏' : '收藏'}}</text>
          </view>
        </view>

        <text class="single-description" wx:if="{{singleOutfit.description}}">{{singleOutfit.description}}</text>

        <view class="single-items" wx:if="{{singleOutfit.items.length}}">
          <text class="single-items-heading">单品清单</text>
          <view class="single-item" wx:for="{{singleOutfit.items}}" wx:key="name">
            <text class="single-item-name">{{item.name}}</text>
            <text class="single-item-brand" wx:if="{{item.brand}}">{{item.brand}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="state-container" wx:elif="{{bestList.length === 0 && secondList.length === 0}}">
      <image class="state-icon" src="/images/icons/image.png" mode="aspectFit" />
      <text>当天还没有配置穿搭方案</text>
    </view>

    <block wx:else>
      <view class="recommend-group">
        <view class="recommend-row">
          <view class="group-title">
            <text class="rank-name">最佳:</text>
            <view class="rank-description">
              <text class="rank-description-line">优先推荐的</text>
              <text class="rank-description-line">场景搭配</text>
            </view>
            <view class="color-chip-row">
              <view
                class="color-chip"
                wx:for="{{bestColorBadges}}"
                wx:key="name"
              >
                <text
                  class="color-chip-dot"
                  style="background-color: {{item.bgColor}}; border-color: {{item.borderColor}};"
                ></text>
                <text class="color-chip-name">{{item.name}}</text>
              </view>
            </view>
          </view>
          <view class="outfit-grid">
            <view class="outfit-card" wx:for="{{bestColumns}}" wx:key="sceneName">
              <text class="scene-name" wx:if="{{item.showSceneName}}">{{item.sceneName}}</text>
              <image
                class="outfit-image"
                wx:if="{{item.item && item.item.coverUrl}}"
                src="{{item.item.coverUrl}}"
                mode="aspectFit"
                lazy-load
                data-url="{{item.item.coverUrl}}"
                bindtap="onPreviewImage"
              />
              <view class="image-placeholder empty-outfit" wx:else>
                <image class="image-placeholder-icon" src="/images/icons/image.png" mode="aspectFit" />
                <text>未创建</text>
              </view>
              <view
                wx:if="{{item.item}}"
                class="collect-button {{item.item.isCollected ? 'is-collected' : ''}}"
                data-id="{{item.item._id}}"
                catchtap="onToggleCollect"
              >
                <image
                  class="collect-icon"
                  src="{{item.item.isCollected ? '/images/icons/star.png' : '/images/icons/star-outline.png'}}"
                  mode="aspectFit"
                />
              </view>
            </view>
          </view>
        </view>
      </view>

      <view class="recommend-group second-group">
        <view class="recommend-row">
          <view class="group-title">
            <text class="rank-name">次佳:</text>
            <view class="rank-description">
              <text class="rank-description-line">同样适合的</text>
              <text class="rank-description-line">备选搭配</text>
            </view>
            <view class="color-chip-row">
              <view
                class="color-chip"
                wx:for="{{secondColorBadges}}"
                wx:key="name"
              >
                <text
                  class="color-chip-dot"
                  style="background-color: {{item.bgColor}}; border-color: {{item.borderColor}};"
                ></text>
                <text class="color-chip-name">{{item.name}}</text>
              </view>
            </view>
          </view>
          <view class="outfit-grid">
            <view class="outfit-card" wx:for="{{secondColumns}}" wx:key="sceneName">
              <text class="scene-name" wx:if="{{item.showSceneName}}">{{item.sceneName}}</text>
              <image
                class="outfit-image"
                wx:if="{{item.item && item.item.coverUrl}}"
                src="{{item.item.coverUrl}}"
                mode="aspectFit"
                lazy-load
                data-url="{{item.item.coverUrl}}"
                bindtap="onPreviewImage"
              />
              <view class="image-placeholder empty-outfit" wx:else>
                <image class="image-placeholder-icon" src="/images/icons/image.png" mode="aspectFit" />
                <text>未创建</text>
              </view>
              <view
                wx:if="{{item.item}}"
                class="collect-button {{item.item.isCollected ? 'is-collected' : ''}}"
                data-id="{{item.item._id}}"
                catchtap="onToggleCollect"
              >
                <image
                  class="collect-icon"
                  src="{{item.item.isCollected ? '/images/icons/star.png' : '/images/icons/star-outline.png'}}"
                  mode="aspectFit"
                />
              </view>
            </view>
          </view>
        </view>
      </view>

      <view class="accessory-section">
        <text class="accessory-heading">幸运配饰</text>
        <view class="accessory-list">
          <view class="accessory-item" wx:for="{{accessories}}" wx:key="_id">
            <image
              wx:if="{{item.imageUrl}}"
              class="accessory-image"
              src="{{item.imageUrl}}"
              mode="aspectFill"
              lazy-load
            />
            <text class="accessory-symbol" wx:else>✦</text>
            <text class="accessory-name">{{item.name}}</text>
            <text class="accessory-description">{{item.description}}</text>
          </view>
        </view>
      </view>
    </block>
  </view>
</view>
</scroll-view>

<bottom-nav current=""></bottom-nav>
