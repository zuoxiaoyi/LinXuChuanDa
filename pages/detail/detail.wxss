page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #f8f3e8;
  color: #3d3529;
}

.page-scroll {
  flex: 1;
  width: 100%;
  height: 0;
  min-height: 0;
}

.detail-page {
  position: relative;
  overflow: hidden;
  background: #f8f3e8;
}

.detail-bg {
  position: absolute;
  top: 0;
  right: 0;
  width: 150%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
}

.detail-content {
  position: relative;
  z-index: 1;
  min-height: calc(100vh - 150rpx - env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  padding: 28rpx 24rpx calc(124rpx + env(safe-area-inset-bottom));
}

.date-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  color: #684b20;
  font-size: 33rpx;
  font-weight: 600;
}

.date-heading-text {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 12rpx;
  min-width: 0;
}

.date-nav {
  flex: none;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.date-nav-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(176, 138, 77, .38);
  border-radius: 50%;
  background: rgba(255, 253, 247, .82);
  color: #8b6630;
  font-size: 38rpx;
  line-height: 1;
  box-shadow: 0 3rpx 10rpx rgba(100, 75, 38, .08);
}

.date-nav-btn.is-disabled {
  opacity: .32;
}

.date-subtitle {
  color: #a3947a;
  font-size: 21rpx;
  font-weight: 400;
}

.recommend-group {
  flex: 1;
  min-height: 0;
  margin-top: 18rpx;
  display: flex;
  flex-direction: column;
}

.second-group {
  margin-top: 10rpx;
}

.recommend-row {
  flex: 1;
  min-height: 0;
  display: flex;
  align-items: stretch;
  gap: 14rpx;
}

.group-title {
  width: 96rpx;
  flex: none;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding-top: 44rpx;
}

.second-group .group-title {
  padding-top: 0;
}

.rank-name {
  color: #6d5025;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.15;
}

.rank-description {
  display: flex;
  flex-direction: column;
  margin-top: 6rpx;
  color: #a1947e;
  font-size: 18rpx;
  line-height: 1.25;
}

.rank-description-line {
  display: block;
}

.color-chip-row {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  margin-top: 8rpx;
  width: 100%;
}

.color-chip {
  width: 90rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: #6d5025;
  font-size: 17rpx;
  line-height: 1.2;
}

.color-chip-dot {
  width: 28rpx;
  height: 28rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(104, 75, 32, .22);
  border-radius: 50%;
  flex: none;
}

.color-chip-name {
  min-width: 24rpx;
}

.outfit-grid {
  flex: 1;
  min-height: 0;
  display: flex;
  justify-content: flex-start;
  gap: 18rpx;
}

.outfit-card {
  flex: 0 0 calc((100% - 36rpx) / 3);
  width: calc((100% - 36rpx) / 3);
  min-width: 0;
  box-sizing: border-box;
  position: relative;
  overflow: visible;
  display: flex;
  flex-direction: column;
  padding: 12rpx 6rpx 10rpx;
  border: 1rpx solid rgba(185, 156, 107, .28);
  border-radius: 18rpx;
  background: rgba(255, 253, 247, .46);
  box-shadow: 0 6rpx 18rpx rgba(100, 75, 38, .07);
}

.outfit-figure {
  flex: 1;
  min-height: 210rpx;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.outfit-image,
.image-placeholder {
  width: 100%;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
}

.outfit-image {
  min-height: 0;
  filter: drop-shadow(0 6rpx 8rpx rgba(96, 74, 42, .22));
}

.outfit-ground {
  width: 76%;
  height: 20rpx;
  margin: 0 auto 6rpx;
  flex: none;
  border-radius: 50%;
  background: rgba(96, 74, 42, .1);
  background: radial-gradient(ellipse at center, rgba(96, 74, 42, .3) 0%, rgba(96, 74, 42, .13) 45%, rgba(96, 74, 42, 0) 78%);
}

.empty-outfit {
  flex-direction: column;
  gap: 8rpx;
  color: #a69982;
  font-size: 22rpx;
}

.state-icon {
  width: 58rpx;
  height: 58rpx;
}

.image-placeholder-icon {
  width: 48rpx;
  height: 48rpx;
}

.scene-name {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.scene-name {
  margin-bottom: 4rpx;
  color: #8b6630;
  font-size: 25rpx;
  font-weight: 700;
  text-align: center;
}

.collect-button {
  position: absolute;
  right: 8rpx;
  bottom: 14rpx;
  width: 42rpx;
  height: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ad9b7b;
}

.collect-button.is-collected {
  color: #c69238;
}

.collect-icon {
  width: 30rpx;
  height: 30rpx;
}

.accessory-section {
  margin-top: auto;
  padding: 16rpx 0 0;
  background: transparent;
}

.accessory-heading {
  color: #684b20;
  font-size: 28rpx;
  font-weight: 600;
}

.accessory-list {
  display: flex;
  justify-content: space-around;
  margin-top: 10rpx;
}

.accessory-item {
  width: 30%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.accessory-symbol {
  height: 74rpx;
  font-size: 54rpx;
  line-height: 74rpx;
}

.accessory-image {
  width: 74rpx;
  height: 74rpx;
  border-radius: 50%;
  background: #efe6d8;
}

.accessory-name {
  margin-top: 8rpx;
  color: #665033;
  font-size: 23rpx;
  font-weight: 600;
}

.accessory-description {
  margin-top: 5rpx;
  color: #a29683;
  font-size: 18rpx;
}

.state-container {
  min-height: 65vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  color: #8d806b;
  font-size: 25rpx;
}

.retry-button {
  margin: 6rpx 0 0;
  padding: 0 34rpx;
  height: 62rpx;
  line-height: 62rpx;
  border: 1rpx solid #b99c6b;
  border-radius: 32rpx;
  background: #fffaf0;
  color: #795a2c;
  font-size: 24rpx;
}

.retry-button::after {
  border: none;
}

/* ===== 单套穿搭详情：底部信息卡固定，剩余空间全部留给图片 ===== */
.single-container {
  flex: 1;
  min-height: 0;
  align-items: stretch;
  justify-content: flex-start;
  gap: 0;
}

.single-outfit {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  padding: 0;
}

.single-figure {
  flex: 1;
  min-height: 300rpx;
  position: relative;
  overflow: hidden;
}

/*
 * 关键修复：不要用 flex:1 + height:0 去撑 <image>。
 * 小程序 image 是原生渲染节点，显式 height:0 会让渲染层拿到 0 高度，
 * 即使 flex 把父容器撑起来了，图片也不会跟着重排 —— 表现就是「上半屏只剩阴影、图片整块空白」。
 * 这里改成绝对定位 + 明确的 calc 宽高，宽高完全不依赖 flex 计算。
 * aspectFit 保证人物头脚完整，drop-shadow 做人物轮廓投影。
 */
.single-cover {
  position: absolute;
  top: 12rpx;
  left: 10rpx;
  width: calc(100% - 20rpx);
  height: calc(100% - 46rpx);
  background: transparent;
  filter: drop-shadow(0 12rpx 16rpx rgba(74, 54, 28, .28));
}

.single-empty {
  position: absolute;
  top: 12rpx;
  left: 10rpx;
  width: calc(100% - 20rpx);
  height: calc(100% - 46rpx);
  flex-direction: column;
  gap: 8rpx;
}

/* 脚底椭圆落地阴影，与每日推荐六图一致 */
.single-ground {
  position: absolute;
  bottom: 4rpx;
  left: 29%;
  width: 42%;
  height: 22rpx;
  border-radius: 50%;
  background: rgba(96, 74, 42, .1);
  background: radial-gradient(ellipse at center, rgba(96, 74, 42, .34) 0%, rgba(96, 74, 42, .14) 48%, rgba(96, 74, 42, 0) 80%);
}

/* 底部信息卡固定高度 + 顶部圆角 + 向上投影，形成压在图片上的层次 */
.single-info {
  flex: none;
  box-sizing: border-box;
  height: 42vh;
  max-height: 42vh;
  margin-top: 10rpx;
  padding: 26rpx 28rpx 24rpx;
  border-radius: 28rpx 28rpx 0 0;
  background: rgba(255, 253, 247, .97);
  box-shadow: 0 -14rpx 34rpx rgba(84, 62, 34, .2), 0 -2rpx 0 rgba(185, 156, 107, .2);
}

.single-title {
  display: block;
  margin-top: 0;
  color: #5d4728;
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  text-align: center;
}

.single-tags {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12rpx;
  margin-top: 16rpx;
}

.single-tag {
  padding: 6rpx 20rpx;
  border-radius: 22rpx;
  background: #f1e8d7;
  color: #806a49;
  font-size: 22rpx;
}

.single-description {
  display: block;
  margin-top: 24rpx;
  padding: 22rpx 24rpx;
  border-radius: 18rpx;
  background: rgba(248, 241, 228, .92);
  color: #6f6555;
  font-size: 25rpx;
  line-height: 1.8;
}

.single-items {
  width: 100%;
  margin-top: 24rpx;
}

.single-items-heading {
  display: block;
  margin-bottom: 14rpx;
  color: #795a2c;
  font-size: 27rpx;
  font-weight: 600;
}

.single-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 22rpx;
  border-radius: 14rpx;
  background: rgba(248, 241, 228, .9);
  box-shadow: 0 4rpx 12rpx rgba(100, 78, 47, .06);
}

.single-item + .single-item {
  margin-top: 12rpx;
}

.single-item-name {
  color: #5d4728;
  font-size: 25rpx;
  font-weight: 500;
}

.single-item-brand {
  color: #9d8b70;
  font-size: 22rpx;
}

/* 原生加载圈（替代 Vant van-loading） */
.lx-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 5rpx solid rgba(176, 138, 77, .25);
  border-top-color: #b08a4d;
  border-radius: 50%;
  animation: lx-spin .8s linear infinite;
}
@keyframes lx-spin {
  to { transform: rotate(360deg); }
}

.preview-layer {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 9999;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background: rgba(22, 18, 13, .96);
}

/* 计数与胶囊同高，关闭键在其正下方；top / right 由 JS 按胶囊矩形动态注入 */
.preview-topbar {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  z-index: 2;
  display: flex;
  align-items: center;
  color: #f6ecd8;
  font-size: 26rpx;
}

.preview-counter {
  letter-spacing: 2rpx;
}

.preview-close {
  position: absolute;
  z-index: 3;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(246, 236, 216, .22);
  border-radius: 50%;
  background: rgba(246, 236, 216, .16);
  color: #f6ecd8;
  font-size: 30rpx;
}

.preview-swiper {
  flex: 1;
  height: 0;
  width: 100%;
}

.preview-slide {
  height: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  padding: 0 24rpx;
}

.preview-photo {
  flex: 1;
  min-height: 0;
  width: 100%;
}

/* 暗色玻璃属性卡：与预览底色融合，替代原来刺眼的纯白块 */
.preview-meta {
  flex: none;
  max-height: 300rpx;
  box-sizing: border-box;
  margin: 12rpx 0 8rpx;
  padding: 22rpx 24rpx 24rpx;
  border: 1rpx solid rgba(246, 236, 216, .14);
  border-radius: 20rpx;
  background: rgba(58, 49, 37, .72);
  backdrop-filter: blur(16rpx);
}

.preview-meta-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.preview-rank {
  flex: none;
  padding: 5rpx 16rpx;
  border-radius: 18rpx;
  background: rgba(201, 166, 102, .26);
  color: #f2ddb6;
  font-size: 21rpx;
}

.preview-title {
  color: #f6ecd8;
  font-size: 30rpx;
  font-weight: 600;
}

.preview-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.preview-badge {
  padding: 7rpx 18rpx;
  border-radius: 22rpx;
  background: rgba(246, 236, 216, .1);
  color: #e8dcc3;
  font-size: 22rpx;
}

.preview-desc {
  display: block;
  margin-top: 16rpx;
  color: rgba(246, 236, 216, .7);
  font-size: 23rpx;
  line-height: 1.7;
}

/* 左右箭头独立贴在图片两侧，不铺满整行，保证点图片区域可关闭预览 */
.preview-arrow {
  position: absolute;
  top: 44%;
  z-index: 4;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: translateY(-50%);
  border: 1rpx solid rgba(246, 236, 216, .28);
  border-radius: 50%;
  background: rgba(18, 14, 10, .42);
  color: #f6ecd8;
  font-size: 46rpx;
  line-height: 1;
}

.preview-arrow--left {
  left: 18rpx;
}

.preview-arrow--right {
  right: 18rpx;
}

.preview-arrow.is-disabled {
  opacity: .25;
}
