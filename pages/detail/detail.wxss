page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #f8f3e8;
  color: #3d3529;
}

.page-scroll {
  flex: 1;
  width: 100%;
  height: 0;
  min-height: 0;
}

.detail-page {
  position: relative;
  overflow: hidden;
  background: #f8f3e8;
}

.detail-bg {
  position: absolute;
  top: 0;
  right: 0;
  width: 150%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
}

.detail-content {
  position: relative;
  z-index: 1;
  min-height: calc(100vh - 150rpx - env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  padding: 28rpx 24rpx calc(124rpx + env(safe-area-inset-bottom));
}

.date-heading {
  display: flex;
  align-items: baseline;
  gap: 18rpx;
  color: #684b20;
  font-size: 33rpx;
  font-weight: 600;
}

.date-subtitle {
  color: #a3947a;
  font-size: 21rpx;
  font-weight: 400;
}

.recommend-group {
  flex: 1;
  min-height: 0;
  margin-top: 18rpx;
  display: flex;
  flex-direction: column;
}

.second-group {
  margin-top: 10rpx;
}

.recommend-row {
  flex: 1;
  min-height: 0;
  display: flex;
  align-items: stretch;
  gap: 14rpx;
}

.group-title {
  width: 96rpx;
  flex: none;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding-top: 44rpx;
}

.second-group .group-title {
  padding-top: 0;
}

.rank-name {
  color: #6d5025;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.15;
}

.rank-description {
  display: flex;
  flex-direction: column;
  margin-top: 6rpx;
  color: #a1947e;
  font-size: 18rpx;
  line-height: 1.25;
}

.rank-description-line {
  display: block;
}

.color-chip-row {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  margin-top: 8rpx;
  width: 100%;
}

.color-chip {
  width: 90rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: #6d5025;
  font-size: 17rpx;
  line-height: 1.2;
}

.color-chip-dot {
  width: 28rpx;
  height: 28rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(104, 75, 32, .22);
  border-radius: 50%;
  flex: none;
}

.color-chip-name {
  min-width: 24rpx;
}

.outfit-grid {
  flex: 1;
  min-height: 0;
  display: flex;
  justify-content: flex-start;
  gap: 18rpx;
}

.outfit-card {
  flex: 0 0 calc((100% - 36rpx) / 3);
  width: calc((100% - 36rpx) / 3);
  min-width: 0;
  position: relative;
  overflow: visible;
  display: flex;
  flex-direction: column;
  background: transparent;
}

.outfit-image,
.image-placeholder {
  width: 100%;
  flex: 1;
  min-height: 210rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
}

.outfit-image {
  cursor: pointer;
}

.empty-outfit {
  flex-direction: column;
  gap: 8rpx;
  color: #a69982;
  font-size: 22rpx;
}

.state-icon {
  width: 58rpx;
  height: 58rpx;
}

.image-placeholder-icon {
  width: 48rpx;
  height: 48rpx;
}

.scene-name {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.scene-name {
  margin-bottom: 4rpx;
  color: #8b6630;
  font-size: 25rpx;
  font-weight: 700;
  text-align: center;
}

.collect-button {
  position: absolute;
  right: 8rpx;
  bottom: 24rpx;
  width: 42rpx;
  height: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ad9b7b;
}

.collect-button.is-collected {
  color: #c69238;
}

.collect-icon {
  width: 30rpx;
  height: 30rpx;
}

.accessory-section {
  margin-top: auto;
  padding: 16rpx 0 0;
  background: transparent;
}

.accessory-heading {
  color: #684b20;
  font-size: 28rpx;
  font-weight: 600;
}

.accessory-list {
  display: flex;
  justify-content: space-around;
  margin-top: 10rpx;
}

.accessory-item {
  width: 30%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.accessory-symbol {
  height: 74rpx;
  font-size: 54rpx;
  line-height: 74rpx;
}

.accessory-image {
  width: 74rpx;
  height: 74rpx;
  border-radius: 50%;
  background: #efe6d8;
}

.accessory-name {
  margin-top: 8rpx;
  color: #665033;
  font-size: 23rpx;
  font-weight: 600;
}

.accessory-description {
  margin-top: 5rpx;
  color: #a29683;
  font-size: 18rpx;
}

.state-container {
  min-height: 65vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  color: #8d806b;
  font-size: 25rpx;
}

.retry-button {
  margin: 6rpx 0 0;
  padding: 0 34rpx;
  height: 62rpx;
  line-height: 62rpx;
  border: 1rpx solid #b99c6b;
  border-radius: 32rpx;
  background: #fffaf0;
  color: #795a2c;
  font-size: 24rpx;
}

.retry-button::after {
  border: none;
}

.single-outfit {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 8rpx 8rpx;
}

.single-cover {
  width: 100%;
  border-radius: 20rpx;
  background: #efe6d4;
  box-shadow: 0 10rpx 26rpx rgba(100, 78, 47, .12);
}

.single-title {
  margin-top: 26rpx;
  color: #5d4728;
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.single-tags {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12rpx;
  margin-top: 16rpx;
}

.single-tag {
  padding: 6rpx 20rpx;
  border-radius: 22rpx;
  background: #f1e8d7;
  color: #806a49;
  font-size: 22rpx;
}

.collect-bar {
  margin-top: 26rpx;
}

.collect-text {
  margin-left: 8rpx;
  color: #785c30;
  font-size: 24rpx;
}

.single-description {
  display: block;
  margin-top: 30rpx;
  padding: 22rpx 24rpx;
  border-radius: 18rpx;
  background: rgba(255, 253, 247, .9);
  color: #6f6555;
  font-size: 25rpx;
  line-height: 1.8;
}

.single-items {
  width: 100%;
  margin-top: 28rpx;
}

.single-items-heading {
  display: block;
  margin-bottom: 14rpx;
  color: #795a2c;
  font-size: 27rpx;
  font-weight: 600;
}

.single-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 22rpx;
  border-radius: 14rpx;
  background: rgba(255, 253, 247, .82);
  box-shadow: 0 4rpx 12rpx rgba(100, 78, 47, .06);
}

.single-item + .single-item {
  margin-top: 12rpx;
}

.single-item-name {
  color: #5d4728;
  font-size: 25rpx;
  font-weight: 500;
}

.single-item-brand {
  color: #9d8b70;
  font-size: 22rpx;
}

/* 原生加载圈（替代 Vant van-loading） */
.lx-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 5rpx solid rgba(176, 138, 77, .25);
  border-top-color: #b08a4d;
  border-radius: 50%;
  animation: lx-spin .8s linear infinite;
}
@keyframes lx-spin {
  to { transform: rotate(360deg); }
}
