<view class="splash-container">
  <navigation-bar
    title="灵序穿搭"
    back="{{false}}"
    color="#111111"
    background="#fffdf8"
  ></navigation-bar>

  <view class="splash-hero">
    <image class="splash-bg" src="/images/common/bg.png" mode="aspectFill" />

    <view class="skip-area" style="{{skipStyle}}" bindtap="onSkip">
      <text class="skip-text">跳过{{countdown}}S</text>
    </view>

    <view class="title-block">
      <image class="title-image" src="/images/common/title.png" mode="widthFix" />
      <text class="title-subtitle">-穿出你的好运势-</text>
    </view>
  </view>
</view>
