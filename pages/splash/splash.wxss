page {
  height: 100vh;
  overflow: hidden;
  background: #fffdf8;
}

.splash-container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #fffdf8;
}

.splash-hero {
  position: relative;
  flex: 1;
  min-height: 0;
  overflow: hidden;
}

.splash-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.skip-area {
  position: absolute;
  right: 22rpx;
  z-index: 2;
  min-width: 112rpx;
  height: 42rpx;
  padding: 0 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: rgba(244, 226, 199, .86);
}

.skip-text {
  color: #000;
  font-size: 21rpx;
  font-weight: 400;
  line-height: 1;
}

.title-block {
  position: absolute;
  left: 50%;
  bottom: calc(190rpx + env(safe-area-inset-bottom));
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-left: 12rpx;
  transform: translateX(-50%);
}

.title-image {
  width: 650rpx;
  max-width: 90vw;
}

.title-subtitle {
  margin-top: 18rpx;
  color: #fffdf8;
  font-size: 30rpx;
  line-height: 1;
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 8rpx rgba(117, 74, 34, .45);
}
