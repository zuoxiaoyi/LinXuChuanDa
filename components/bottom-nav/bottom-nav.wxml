<view class="nav-shell">
  <view
    class="nav-item {{current === 'home' ? 'is-active' : ''}}"
    data-page="home"
    bindtap="onNavigate"
  >
    <image class="local-icon" src="/images/icons/tab-home.png" mode="aspectFit" />
    <text>首页</text>
  </view>
  <view
    class="nav-item {{current === 'mine' ? 'is-active' : ''}}"
    data-page="mine"
    bindtap="onNavigate"
  >
    <image class="local-icon" src="/images/icons/tab-mine.png" mode="aspectFit" />
    <text>我的</text>
  </view>
</view>
